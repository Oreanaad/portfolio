# Copy to .env for local development and set the real values.
# In production these live in Netlify: Site settings > Environment variables.
# Never commit the filled-in .env — it is gitignored for a reason.

# --- Contact form (Netlify Function: netlify/functions/sendEmail.js) ---
# For Gmail, SMTP_PASS must be an App Password, not the account password:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password

# Where contact form submissions are delivered. Defaults to SMTP_USER if unset.
MAIL_TO=your-address@gmail.com
